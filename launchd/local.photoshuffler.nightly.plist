<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. scripts/install.sh fills in __APP__, __HOME__, __HOUR__ and __MINUTE__
  and installs the result to ~/Library/LaunchAgents/.
  It's a LaunchAgent (not a daemon) because the Photos library and its permission
  belong to your user session: you need to be logged in for it to run.
  If the Mac is asleep at the scheduled time, launchd runs the job when it wakes.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.photoshuffler.nightly</string>
	<key>ProgramArguments</key>
	<array>
		<string>__APP__/Contents/MacOS/PhotoShuffler</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>__HOUR__</integer>
		<key>Minute</key>
		<integer>__MINUTE__</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/PhotoShuffler/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/PhotoShuffler/launchd.err.log</string>
</dict>
</plist>
